# MongoDB Atlas connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.tnfayum.mongodb.net/lostandfound?retryWrites=true&w=majority&appName=Cluster0

# Cryptographic JWT Secret
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters

# Custom Domain / Site URL (e.g. https://lostfound.org or https://yourdomain.com)
NEXT_PUBLIC_APP_URL=https://yourdomain.com
